<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN"
    "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Services">
        <folder name="AutoupdateType">
            <file name="github-releases-update-center.instance">
                <attr name="displayName" stringvalue="NetBeans Plugin GitHub Releases"/>
                <attr name="enabled" boolvalue="true"/>
                <attr name="instanceCreate"
                      methodvalue="org.netbeans.modules.autoupdate.updateprovider.AutoupdateCatalogFactory.createUpdateProvider"/>
                <attr name="instanceOf" stringvalue="org.netbeans.spi.autoupdate.UpdateProvider"/>
                <attr name="url"
                      urlvalue="https://github.com/nipunanirmal/NetbeansPlugin-IDE-Devin-ClaudeCode/releases/latest/download/updates.xml"/>
            </file>
        </folder>
    </folder>

    <folder name="OptionsDialog">
        <file name="ClaudeCodeGUI.instance">
            <attr methodvalue="org.netbeans.spi.options.OptionsCategory.createCategory"
                  name="instanceCreate"/>
            <attr name="controller"
                  newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeCodeOptionsPanelController"/>
            <attr bundlevalue="io.github.nbplugins.claudecodegui.Bundle#OptionsCategory_Name_ClaudeCodeGUI"
                  name="categoryName"/>
            <attr bundlevalue="io.github.nbplugins.claudecodegui.Bundle#OptionsCategory_Keywords_ClaudeCodeGUI"
                  name="keywords"/>
            <attr name="keywordsCategory" stringvalue="ClaudeCodeGUI"/>
            <attr name="position" intvalue="1500"/>
        </file>
    </folder>

    <!-- Project Properties — Claude Code panel (Maven) -->
    <folder name="Projects">
        <folder name="org-netbeans-modules-maven">
            <folder name="Customizer">
                <file name="ClaudeCodePanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
        <folder name="org-netbeans-modules-java-j2seproject">
            <folder name="Customizer">
                <file name="ClaudeCodePanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
        <folder name="org-netbeans-modules-gradle">
            <folder name="Customizer">
                <file name="ClaudeCodePanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
    </folder>


    <!-- Inline AI actions (assign shortcuts via Tools → Keyboard Shortcuts) -->
    <folder name="Editors">
        <folder name="Actions">
            <file name="trigger-inline-ai-completion.instance">
                <attr name="instanceCreate"
                      newvalue="io.github.nbplugins.claudecodegui.inline.TriggerCompletionAction"/>
            </file>
            <file name="show-inline-ai-instruction.instance">
                <attr name="instanceCreate"
                      newvalue="io.github.nbplugins.claudecodegui.inline.ShowInstructionAction"/>
            </file>
        </folder>
    </folder>

</filesystem>
